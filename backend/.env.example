# ================================================
# COPY THIS FILE TO .env AND FILL IN YOUR API KEYS
# ================================================
# This is the MAIN configuration file that contains your API keys
# There's also a separate .env.landing_ai file for SDK settings (no keys)

# ===============================
# REQUIRED API KEYS
# ===============================

# Landing.AI API Key (REQUIRED)
# Get your key from: https://landing.ai/dashboard
VISION_AGENT_API_KEY=your-landing-ai-api-key-here

# OpenAI API Key (REQUIRED for fallback when Landing.AI fails)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ===============================
# APPLICATION SETTINGS
# ===============================

# Application Info
APP_NAME=ApexADE
APP_VERSION=0.1.0
DEBUG=True

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database (SQLite by default, works fine for most use cases)
DATABASE_URL=sqlite:///./apex_ade.db

# File Upload Settings
# For large documents (900MB+), increase this value
MAX_UPLOAD_SIZE=1524288000  # 500MB default for large documents
UPLOAD_DIRECTORY=./uploads

# Security
SECRET_KEY=your-secret-key-here-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===============================
# OPTIONAL SETTINGS
# ===============================

# OpenAI Model Settings
OPENAI_MODEL=gpt-5  # Latest model as of August 2025
# IMPORTANT: Use OPENAI_MAX_COMPLETION_TOKENS instead of OPENAI_MAX_TOKENS
# OPENAI_MAX_TOKENS is deprecated and will be removed in future versions
# If both are set, OPENAI_MAX_COMPLETION_TOKENS takes precedence
OPENAI_MAX_COMPLETION_TOKENS=8192  # Maximum tokens for GPT-5 responses
# OPENAI_MAX_TOKENS=4096  # DEPRECATED - Use OPENAI_MAX_COMPLETION_TOKENS instead
OPENAI_TEMPERATURE=0.1  # Lower temperature for accurate document extraction
OPENAI_VERBOSITY=medium  # Options: low, medium, high - controls response length
OPENAI_REASONING_EFFORT=medium  # Options: minimal, low, medium, high

# CORS Settings (add your frontend URL)
BACKEND_CORS_ORIGINS=['http://localhost:3000']

# ===============================
# IMPORTANT NOTES
# ===============================
# 1. This file contains SECRETS - never commit to git!
# 2. The .env.landing_ai file is separate and contains SDK settings (no keys)
# 3. Both files are loaded automatically when the app starts
# 4. To verify setup, start server with: uvicorn app.main:app --reload